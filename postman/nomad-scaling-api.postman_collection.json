{
  "info": {
    "_postman_id": "564c7669-2eb7-4367-884e-7c7fe962f7b5",
    "name": "HashiCorp Nomad HTTP ACL Scaling API",
    "description": "The HashiCorp Nomad HTTP API provides programmatic access to all Nomad functionality including job scheduling, allocation management, node operations, deployments, services, evaluations, namespaces, ACL policies, and cluster status. All API routes are prefixed with /v1/ and the default port is 4646. The API is RESTful, responds to standard HTTP verbs, and supports ACL token authentication via the X-Nomad-Token header or Bearer scheme.\n\nContact Support:\n Name: HashiCorp Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:23:35.000Z",
    "updatedAt": "2026-07-28T02:23:35.000Z",
