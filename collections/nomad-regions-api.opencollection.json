{
  "opencollection": "1.0.0",
  "info": {
    "name": "HashiCorp Nomad HTTP ACL Regions API",
    "version": "1.9.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Nomad-Token",
      "value": "{{X-Nomad-Token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Regions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:4646/v1/regions"
          },
          "docs": "Returns a list of all known regions in the Nomad cluster."
        }
      ]
    }
  ],
  "bundled": true
}